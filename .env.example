# Local defaults. Never use local auth for a hosted deployment.
CHESSLAB_ENV=development
CHESSLAB_AUTH_MODE=local
CHESSLAB_LOCAL_USER_ID=1
CHESSLAB_DATABASE_PATH=data/chesslab.db
CHESSLAB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Railway: production, supabase, and PostgreSQL DATABASE_URL are required.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: leave empty for open registration; set emails only to restrict access.
CHESSLAB_ALLOWED_EMAILS=
# Keep expensive synchronous engine endpoints disabled for the initial beta.
CHESSLAB_ENGINE_ENABLED=false
